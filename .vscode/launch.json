{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NetScope: GUI",
      "type": "debugpy",
      "request": "launch",
      "module": "netscope.gui",
      "console": "integratedTerminal"
    },
    {
      "name": "NetScope: Diagnose (CLI)",
      "type": "debugpy",
